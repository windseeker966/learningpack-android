[Unit]
Description=LearningPack 中转服务器（手机和 iPad 交换加密数据块）
After=network-online.target

[Service]
ExecStart=/usr/bin/python3 /opt/lp-relay/lp_relay.py --port 47322
DynamicUser=yes
StateDirectory=lp-relay
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
MemoryMax=256M

[Install]
WantedBy=multi-user.target
